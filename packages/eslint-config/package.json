{
    "name": "@emm-ess-configs/eslint-config",
    "version": "0.4.0",
    "description": "The base eslint config for my projects.",
    "keywords": [
        "eslint",
        "eslintconfig"
    ],
    "homepage": "https://github.com/emm-ess/emm-ess-configs",
    "bugs": "https://github.com/emm-ess/emm-ess-configs/issues",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/emm-ess/emm-ess-configs.git",
        "directory": "packages/eslint-config"
    },
    "license": "MIT",
    "author": {
        "name": "Marten Schälicke",
        "url": "https://emm-ess.de"
    },
    "type": "module",
    "exports": {
        ".": "./dist/index.js",
        "./browser": "./dist/browser.js",
        "./helper": "./dist/helper.js",
        "./node": "./dist/node.js",
        "./type-checked": "./dist/type-checked.js"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "rm -rf dist && tsc",
        "lint": "eslint --cache --fix .",
        "prepublishOnly": "npm run build",
        "type-check": "tsc --noEmit"
    },
    "browserslist": [
        "maintained node versions"
    ],
    "dependencies": {
        "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
        "@eslint/js": "^10.0.1",
        "@eslint/json": "^2.1.1",
        "@eslint/markdown": "^8.0.3",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-compat": "^7.0.2",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-package-json": "^1.10.1",
        "eslint-plugin-regexp": "^3.3.1",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-sonarjs": "^4.2.2",
        "eslint-plugin-unicorn": "^78.0.0",
        "globals": "^17.13.0",
        "neostandard": "^0.14.1",
        "typescript-eslint": "^8.71.2"
    },
    "devDependencies": {
        "@tsconfig/node24": "^24.0.5",
        "@tsconfig/strictest": "^2.0.8",
        "@types/node": "^24.12.4",
        "typescript": "^6.0.3"
    },
    "peerDependencies": {
        "eslint": "^10",
        "typescript": "^6"
    }
}
