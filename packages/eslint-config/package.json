{
    "name": "@emm-ess-configs/eslint-config",
    "version": "0.4.0",
    "description": "The base eslint config for my projects.",
    "keywords": [
        "eslint",
        "eslintconfig"
    ],
    "homepage": "https://github.com/emm-ess/emm-ess-configs",
    "bugs": "https://github.com/emm-ess/emm-ess-configs/issues",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/emm-ess/emm-ess-configs.git",
        "directory": "packages/eslint-config"
    },
    "license": "MIT",
    "author": {
        "name": "Marten Schälicke",
        "url": "https://emm-ess.de"
    },
    "type": "module",
    "exports": {
        ".": "./dist/index.js",
        "./helper": "./dist/helper.js",
        "./type-checked": "./dist/type-checked.js"
    },
    "files": [
        "*"
    ],
    "scripts": {
        "build": "rm -rf dist && tsc",
        "lint": "eslint --report-unused-disable-directives --cache --fix .",
        "prepublish": "build",
        "type-check": "tsc --noEmit"
    },
    "browserslist": [
        "maintained node versions"
    ],
    "dependencies": {
        "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
        "@eslint/config-helpers": "^0.6.0",
        "@eslint/js": "^9.39.4",
        "eslint-plugin-compat": "^7.0.2",
        "eslint-plugin-import-x": "^4.16.2",
        "eslint-plugin-json": "^4.0.1",
        "eslint-plugin-simple-import-sort": "^13.0.0",
        "eslint-plugin-sonarjs": "^4.0.3",
        "eslint-plugin-unicorn": "^64.0.0",
        "globals": "^17.6.0",
        "neostandard": "^0.13.0",
        "typescript-eslint": "^8.60.0"
    },
    "devDependencies": {
        "@tsconfig/node24": "^24.0.4",
        "@tsconfig/strictest": "^2.0.8",
        "@types/node": "^24.12.4",
        "typescript": "^6.0.3"
    },
    "peerDependencies": {
        "eslint": "^9.39.4"
    }
}
