{
    "name": "@emm-ess-configs/eslint-config",
    "version": "0.3.0",
    "description": "The base eslint config for my projects.",
    "keywords": [
        "eslint",
        "eslintconfig"
    ],
    "homepage": "https://github.com/emm-ess/emm-ess-configs",
    "bugs": "https://github.com/emm-ess/emm-ess-configs/issues",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/emm-ess/emm-ess-configs.git",
        "directory": "packages/eslint-config"
    },
    "license": "MIT",
    "author": {
        "name": "Marten Schälicke",
        "url": "https://emm-ess.de"
    },
    "type": "module",
    "exports": {
        ".": "./dist/index.js",
        "./typeChecked": "./dist/typeChecked.js"
    },
    "scripts": {
        "build": "rm -rf dist && tsc",
        "lint": "eslint --report-unused-disable-directives --cache --fix .",
        "prepublish": "build",
        "type-check": "tsc --noEmit"
    },
    "dependencies": {
        "@eslint/compat": "^1.4.0",
        "@eslint/eslintrc": "^3.3.1",
        "@eslint/js": "^9.37.0",
        "eslint-plugin-compat": "^6.0.2",
        "eslint-plugin-eslint-comments": "^3.2.0",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-json": "^4.0.1",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "eslint-plugin-sonarjs": "^3.0.5",
        "eslint-plugin-unicorn": "^61.0.2",
        "globals": "^16.4.0",
        "neostandard": "^0.12.2",
        "typescript-eslint": "^8.46.0"
    },
    "devDependencies": {
        "@tsconfig/node22": "^22.0.2",
        "@tsconfig/strictest": "^2.0.6",
        "@types/node": "^24.7.2",
        "typescript": "^5.9.3"
    },
    "peerDependencies": {
        "eslint": "^9.37.0"
    }
}
