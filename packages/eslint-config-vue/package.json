{
    "name": "@emm-ess-configs/eslint-config-vue",
    "version": "0.3.1",
    "description": "The base eslint config for my vue projects.",
    "keywords": [
        "eslint",
        "eslintconfig"
    ],
    "homepage": "https://github.com/emm-ess/emm-ess-configs",
    "bugs": "https://github.com/emm-ess/emm-ess-configs/issues",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/emm-ess/emm-ess-configs.git",
        "directory": "packages/eslint-config-vue"
    },
    "license": "MIT",
    "author": {
        "name": "Marten Schälicke",
        "url": "https://emm-ess.de"
    },
    "type": "module",
    "exports": {
        ".": "./dist/index.js"
    },
    "files": [
        "*"
    ],
    "scripts": {
        "build": "rm -rf dist && tsc",
        "lint": "eslint --report-unused-disable-directives --cache --fix .",
        "prepublish": "build",
        "type-check": "tsc --noEmit"
    },
    "dependencies": {
        "@emm-ess-configs/eslint-config": "^0.3.1",
        "eslint-plugin-vue": "^10.6.2",
        "typescript-eslint": "^8.50.1"
    },
    "devDependencies": {
        "@tsconfig/node24": "^24.0.3",
        "@tsconfig/strictest": "^2.0.8",
        "@types/node": "^24.7.2",
        "typescript": "^5.9.3"
    },
    "peerDependencies": {
        "eslint": "^9.37.0"
    }
}
